digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11, color="#A18BC5", fillcolor="#FBF8FF"];
  edge [color="#77648E", penwidth=1.4];
  cold [label="Cold Start\n元資料 + 質問だけ"];
  run [label="100問実行"];
  score [label="回答 / Evidence / timeout\nを自動評価"];
  audit [label="低確信度を原資料で監査"];
  fix [label="処理をExecutorへ一般化"];
  cold->run->score->audit->fix->cold;
}
