digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.35", ranksep="0.65"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11, margin="0.15,0.10", color="#8AA4C8", fillcolor="#F7FAFF"];
  edge [color="#607D8B", penwidth=1.4, arrowsize=0.8];
  q [label="ユーザー質問"];
  qu [label="Query Understanding\n同義語・略称・対象期間"];
  meta [label="Metadata Filter\n案件 / 種別 / 版 / 権限", fillcolor="#FFF9F0", color="#D5A85A"];
  bm [label="BM25\n型式・ID・固有名詞"];
  vec [label="Vector Search\n意味的類似"];
  rrf [label="RRF / Hybrid Merge"];
  rr [label="Reranker\n上位context選定"];
  route [label="Router\n普通のQA?\n計算・差分・表処理?", shape=diamond, fillcolor="#F7F3FF", color="#A18BC5"];
  llm [label="LLM\n回答生成"];
  tool [label="Executor / Tool\nPython / Diff / OCR / 集計", fillcolor="#F4FFF7", color="#78B58B"];
  gate [label="Evidence / Citation Gate"];
  out [label="回答 + 出典"];
  q->qu->meta;
  meta->bm; meta->vec;
  bm->rrf; vec->rrf; rrf->rr->route;
  route->llm [label="自然言語QA", fontname="Noto Sans CJK JP"];
  route->tool [label="構造化処理", fontname="Noto Sans CJK JP"];
  llm->gate; tool->gate; gate->out;
}
