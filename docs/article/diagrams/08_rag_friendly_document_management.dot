digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.28", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=11, color="#8AA4C8", fillcolor="#F7FAFF", margin="0.16,0.10"];
  edge [color="#607D8B", penwidth=1.4];
  author [label="資料作成\n明確な見出し / 主語 / 単位 / 用語定義"];
  struct [label="構造化\n1セクション1トピック\n表・画像にcaptionと元データ"];
  lifecycle [label="版管理\ndocument_id固定\nDraft / Approved / Obsolete"];
  meta [label="Metadata\nproject / type / version / date / ACL"];
  ingest [label="Ingestion\nsection-aware chunking\nmetadata enrichment"];
  index [label="Hybrid Index\nkeyword + vector + filter"];
  answer [label="RAG\n最新・正規・権限内の資料だけで回答", fillcolor="#F4FFF7", color="#78B58B"];
  author->struct->lifecycle->meta->ingest->index->answer;
}
