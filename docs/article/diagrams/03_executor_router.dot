digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK JP", fontsize=12, color="#8AA4C8", fillcolor="#F7FAFF"];
  edge [color="#607D8B", penwidth=1.4];
  q [label="Question Plan"];
  sp [label="Specialized Executor\n契約解釈 / 表示精度など", fillcolor="#FFF5F5", color="#D99A9A"];
  gen [label="Generalization Executor\nExcel集計 / Notebook再計算 / JOIN / OCR"];
  base [label="Base Recovery\ndirect / table / diff / chart / spatial"];
  ans [label="Candidate Answer + Evidence", fillcolor="#F4FFF7", color="#78B58B"];
  q->sp; sp->ans [label=" handled", fontname="Noto Sans CJK JP"];
  sp->gen [label=" abstain", fontname="Noto Sans CJK JP"];
  gen->ans [label=" handled", fontname="Noto Sans CJK JP"];
  gen->base [label=" abstain", fontname="Noto Sans CJK JP"];
  base->ans;
}
